# Copy to .env and fill in real values before running.

PORT=3000

# Secret used to sign session tokens returned from login. Generate with: openssl rand -hex 32
JWT_SECRET=

# SMTP — used to email verification codes to Staff / Library Assistant accounts
# (accounts that register with a work email). Resident accounts register with
# a phone number only, and this system has no SMS provider wired up yet — see
# README for how residents get verified in the meantime.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=library@unityhomes.co.ke

# Where the SQLite database file lives. Back this file up regularly.
DB_PATH=./data/library.db

# Comma-separated list of origins allowed to call this API — your deployed
# front-end domain(s). Leave blank to allow any origin (fine for local testing
# only, not for production).
ALLOWED_ORIGINS=
